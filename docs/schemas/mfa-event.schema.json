{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/planner-mcp/schemas/0.1.0/mfa-event.json",
  "title": "SanitizedMfaEvent",
  "description": "The ONLY fields permitted to leave the worker for an MFA event. Approval happens exclusively in Microsoft Authenticator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation_id", "service", "description", "mfa_number", "expires_at"],
  "properties": {
    "operation_id": { "type": "string", "pattern": "^op_[A-Za-z0-9_-]+$" },
    "service": { "const": "microsoft" },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "mfa_number": { "type": "string", "pattern": "^[0-9]{1,4}$" },
    "expires_at": { "type": "string", "format": "date-time" }
  }
}
