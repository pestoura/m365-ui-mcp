{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pestoura/planner-mcp/schemas/0.1.0/extended-tool-manifest.json",
  "title": "ExtendedToolManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "tools"],
  "properties": {
    "contract_version": { "const": "0.1.0" },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "trust_level",
        "mutation_class",
        "reversible",
        "idempotency_class",
        "approval_requirement",
        "attestation_status"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^planner_[a-z0-9_]+$" },
        "description": { "type": "string", "minLength": 1 },
        "trust_level": {
          "enum": ["INTROSPECTION", "TENANT_READ", "TENANT_WRITE", "PRIVILEGED"]
        },
        "mutation_class": {
          "enum": ["READ", "SAFE_WRITE", "GOVERNED_WRITE", "DESTRUCTIVE"]
        },
        "reversible": { "enum": [true, false, "n/a"] },
        "idempotency_class": {
          "enum": [
            "PURE_READ",
            "NATURAL_IDEMPOTENT",
            "KEYED_IDEMPOTENT",
            "NON_IDEMPOTENT"
          ]
        },
        "approval_requirement": {
          "enum": ["NONE", "POLICY_CONDITIONAL", "ALWAYS"]
        },
        "attestation_status": {
          "enum": [
            "UNVERIFIED_LIVE",
            "DISCOVERED",
            "UI_ATTESTED",
            "READ_ATTESTED",
            "MUTATION_ATTESTED",
            "SUPPORTED"
          ]
        },
        "policy_rule_id": { "type": "string" },
        "required_locks": { "type": "array", "items": { "type": "string" } },
        "read_back_strategy": { "type": "string" },
        "drift_behavior": { "const": "FAIL_CLOSED" }
      }
    }
  }
}
